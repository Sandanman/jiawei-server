{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": ["ES2020"],
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": false,
        "sourceMap": true,
        "moduleResolution": "node",
        "baseUrl": "./src",
        "paths": {
            "@/*": ["./*"],
            "@config/*": ["config/*"],
            "@routes/*": ["routes/*"],
            "@controllers/*": ["controllers/*"],
            "@services/*": ["services/*"],
            "@utils/*": ["utils/*"],
            "@middlewares/*": ["middlewares/*"],
            "@db/*": ["db/*"]
        }
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
